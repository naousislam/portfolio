# This file is a template and IS committed to git. Never put a real key here.
# Copy it to .env (which git ignores) and fill in the values there.

# Resend API key for the contact form (https://resend.com/api-keys).
# Leave empty in development to log messages to the terminal instead of sending.
RESEND_API_KEY=

# Optional overrides. Defaults are set in src/env.ts.
# Where contact form messages are delivered.
CONTACT_TO=nao@naous.dev
# The sender shown on those messages. Its domain must be verified in Resend.
CONTACT_FROM="New Portfolio Connection <portfolio@naous.dev>"

# Cloudflare Turnstile bot check (https://dash.cloudflare.com -> Turnstile). Leave empty to turn it off.
# The site key is public; the secret key is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for a rate limit shared across server instances. Optional.
# Without it, limits are counted in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
